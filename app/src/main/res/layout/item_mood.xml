<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="12dp"
    app:cardBackgroundColor="@color/surface_card_vintage"
    app:cardCornerRadius="24dp"
    app:cardElevation="4dp"
    app:strokeColor="@color/retro_purple_light"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Modern emoji card with gradient -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/emojiCard"
            android:layout_width="64dp"
            android:layout_height="64dp"
            app:cardBackgroundColor="@color/retro_purple"
            app:cardCornerRadius="32dp"
            app:cardElevation="4dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/moodEmojiTextView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="😊"
                android:textSize="32sp"
                android:textColor="@color/white" />

        </com.google.android.material.card.MaterialCardView>

        <!-- Mood content -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="@+id/emojiCard"
            app:layout_constraintEnd_toStartOf="@+id/actionContainer"
            app:layout_constraintStart_toEndOf="@+id/emojiCard"
            app:layout_constraintTop_toTopOf="@+id/emojiCard">

            <TextView
                android:id="@+id/moodNoteTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Feeling great today!"
                android:textColor="@color/text_primary_vintage"
                android:textSize="15sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:maxLines="2"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/moodDateTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="June 15, 2023 • 10:30 AM"
                android:textColor="@color/text_secondary_vintage"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- Action buttons -->
        <LinearLayout
            android:id="@+id/actionContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginStart="12dp"
            app:layout_constraintBottom_toBottomOf="@+id/emojiCard"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/emojiCard">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="40dp"
                android:layout_height="40dp"
                app:cardBackgroundColor="@color/surface_card_vintage"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/retro_purple_light"
                app:strokeWidth="1dp">

                <ImageButton
                    android:id="@+id/shareButton"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Share mood"
                    android:padding="8dp"
                    android:src="@drawable/ic_share"
                    app:tint="@color/retro_purple" />

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                app:cardBackgroundColor="@color/surface_card_vintage"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/retro_purple_light"
                app:strokeWidth="1dp">

                <ImageButton
                    android:id="@+id/deleteButton"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Delete mood"
                    android:padding="8dp"
                    android:src="@drawable/ic_delete"
                    app:tint="@color/error_vintage" />

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>