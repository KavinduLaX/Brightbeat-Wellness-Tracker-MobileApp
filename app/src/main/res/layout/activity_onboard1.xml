<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_light">

    <LinearLayout
        android:id="@+id/top_section"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_above="@id/content_section"
        android:layout_alignParentTop="true"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@color/surface_card"
        android:padding="32dp">

        <ImageView
            android:id="@+id/onboard_illustration"
            android:layout_width="280dp"
            android:layout_height="280dp"
            android:src="@drawable/o1"
            android:contentDescription="@string/onboard_welcome_image"
            android:scaleType="centerInside"/>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/content_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/navigation_section"
        android:orientation="vertical"
        android:padding="32dp"
        android:gravity="center">

        <TextView
            android:id="@+id/onboard_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Welcome to BrightBeat"
            android:textSize="28sp"
            android:textColor="@color/text_primary"
            android:fontFamily="sans-serif-medium"
            android:textAlignment="center"
            android:letterSpacing="0.01"/>

        <TextView
            android:id="@+id/onboard_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Start your journey toward balance and better habits. Track your progress, grow with intention, and celebrate every small victory."
            android:textSize="16sp"
            android:textColor="@color/text_secondary"
            android:fontFamily="sans-serif"
            android:textAlignment="center"
            android:lineSpacingExtra="4dp"/>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/navigation_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:padding="24dp">

        <LinearLayout
            android:id="@+id/page_indicators"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <View
                android:id="@+id/indicator_1"
                android:layout_width="32dp"
                android:layout_height="4dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/indicator_active"
                android:backgroundTint="@color/primary_coral"/>

            <View
                android:id="@+id/indicator_2"
                android:layout_width="8dp"
                android:layout_height="4dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/indicator_inactive"
                android:backgroundTint="@color/neutral_300"/>

            <View
                android:id="@+id/indicator_3"
                android:layout_width="8dp"
                android:layout_height="4dp"
                android:background="@drawable/indicator_inactive"
                android:backgroundTint="@color/neutral_300"/>

        </LinearLayout>

        <Button
            android:id="@+id/nextButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Next"
            android:textSize="16sp"
            android:textColor="@color/text_on_primary"
            android:background="@drawable/button_primary"
            android:backgroundTint="@color/primary_coral"
            android:fontFamily="sans-serif-medium"
            android:elevation="2dp"
            android:stateListAnimator="@null"/>

        <TextView
            android:id="@+id/skipButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:text="Skip"
            android:textSize="14sp"
            android:textColor="@color/text_tertiary"
            android:fontFamily="sans-serif"
            android:padding="8dp"/>

    </LinearLayout>

</RelativeLayout>
