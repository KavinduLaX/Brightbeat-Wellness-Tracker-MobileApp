<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/dialog_retro_background"
    android:padding="24dp">

    <!-- Header -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:text="Select Your Mood"
        android:textAlignment="center"
        android:textColor="@color/text_primary_vintage"
        android:textSize="22sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium" />

    <!-- Mood Grid -->
    <GridLayout
        android:id="@+id/moodGridLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="24dp"
        android:columnCount="4"
        android:rowCount="2"
        android:alignmentMode="alignMargins"
        android:columnOrderPreserved="false"
        android:useDefaultMargins="true">

        <!-- Mood items will be added programmatically or statically -->
        <!-- Example mood item: -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="76dp"
            android:layout_columnWeight="1"
            android:layout_margin="6dp"
            app:cardBackgroundColor="@color/surface_card_vintage"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/retro_purple_light"
            app:strokeWidth="1dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackground"
                android:gravity="center"
                android:text="😊"
                android:textSize="36sp"
                android:textColor="@color/text_primary_vintage" />

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="76dp"
            android:layout_columnWeight="1"
            android:layout_margin="6dp"
            app:cardBackgroundColor="@color/surface_card_vintage"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/retro_purple_light"
            app:strokeWidth="1dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackground"
                android:gravity="center"
                android:text="😢"
                android:textSize="36sp"
                android:textColor="@color/text_primary_vintage" />

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="76dp"
            android:layout_columnWeight="1"
            android:layout_margin="6dp"
            app:cardBackgroundColor="@color/surface_card_vintage"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/retro_purple_light"
            app:strokeWidth="1dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackground"
                android:gravity="center"
                android:text="😡"
                android:textSize="36sp"
                android:textColor="@color/text_primary_vintage" />

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="76dp"
            android:layout_columnWeight="1"
            android:layout_margin="6dp"
            app:cardBackgroundColor="@color/surface_card_vintage"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/retro_purple_light"
            app:strokeWidth="1dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackground"
                android:gravity="center"
                android:text="😴"
                android:textSize="36sp"
                android:textColor="@color/text_primary_vintage" />

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="76dp"
            android:layout_columnWeight="1"
            android:layout_margin="6dp"
            app:cardBackgroundColor="@color/surface_card_vintage"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/retro_purple_light"
            app:strokeWidth="1dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackground"
                android:gravity="center"
                android:text="😰"
                android:textSize="36sp"
                android:textColor="@color/text_primary_vintage" />

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="76dp"
            android:layout_columnWeight="1"
            android:layout_margin="6dp"
            app:cardBackgroundColor="@color/surface_card_vintage"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/retro_purple_light"
            app:strokeWidth="1dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackground"
                android:gravity="center"
                android:text="😌"
                android:textSize="36sp"
                android:textColor="@color/text_primary_vintage" />

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="76dp"
            android:layout_columnWeight="1"
            android:layout_margin="6dp"
            app:cardBackgroundColor="@color/surface_card_vintage"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/retro_purple_light"
            app:strokeWidth="1dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackground"
                android:gravity="center"
                android:text="🤗"
                android:textSize="36sp"
                android:textColor="@color/text_primary_vintage" />

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="76dp"
            android:layout_columnWeight="1"
            android:layout_margin="6dp"
            app:cardBackgroundColor="@color/surface_card_vintage"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/retro_purple_light"
            app:strokeWidth="1dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackground"
                android:gravity="center"
                android:text="😎"
                android:textSize="36sp"
                android:textColor="@color/text_primary_vintage" />

        </com.google.android.material.card.MaterialCardView>

    </GridLayout>

    <!-- Cancel Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/cancelButton"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Cancel"
        android:textColor="@color/text_secondary_vintage"
        android:textSize="14sp"
        android:textStyle="bold"
        app:cornerRadius="26dp" />

</LinearLayout>