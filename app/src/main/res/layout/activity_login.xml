<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_vintage"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Back Button -->
        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginBottom="24dp"
            android:src="@drawable/ic_arrow_back"
            android:background="@drawable/button_icon_background"
            android:contentDescription="@string/back_button"
            android:tint="@color/text_primary_vintage"/>

        <!-- Header Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="32dp">

            <!-- App Logo -->
            <ImageView
                android:id="@+id/app_logo"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginBottom="16dp"
                android:src="@drawable/ic_zen_steps_logo"
                android:contentDescription="@string/app_logo"/>

            <!-- Title -->
            <TextView
                android:id="@+id/login_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Welcome Back"
                android:textSize="32sp"
                android:textColor="@color/text_primary_vintage"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.01"/>

            <!-- Subtitle -->
            <TextView
                android:id="@+id/login_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Sign in to continue your wellness journey"
                android:textSize="16sp"
                android:textColor="@color/text_secondary_vintage"
                android:fontFamily="sans-serif"/>

        </LinearLayout>

        <!-- Login Form -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="24dp">

            <!-- Email Input -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/email_input_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:hint="Email"
                app:boxBackgroundColor="@color/surface_card_vintage"
                app:boxStrokeColor="@color/retro_orange"
                app:boxStrokeWidth="2dp"
                app:boxCornerRadiusTopStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusBottomEnd="12dp"
                app:startIconDrawable="@drawable/ic_email"
                app:startIconTint="@color/retro_orange">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/emailEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textEmailAddress"
                    android:textSize="16sp"
                    android:textColor="@color/text_primary_vintage"
                    android:fontFamily="sans-serif"/>

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Password Input -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/password_input_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:hint="Password"
                app:boxBackgroundColor="@color/surface_card_vintage"
                app:boxStrokeColor="@color/retro_orange"
                app:boxStrokeWidth="2dp"
                app:boxCornerRadiusTopStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusBottomEnd="12dp"
                app:startIconDrawable="@drawable/ic_lock"
                app:startIconTint="@color/retro_orange"
                app:endIconMode="password_toggle"
                app:endIconTint="@color/retro_orange">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/passwordEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:textSize="16sp"
                    android:textColor="@color/text_primary_vintage"
                    android:fontFamily="sans-serif"/>

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Forgot Password -->
            <TextView
                android:id="@+id/btn_forgot_password"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginBottom="24dp"
                android:text="Forgot Password?"
                android:textSize="14sp"
                android:textColor="@color/retro_orange"
                android:fontFamily="sans-serif-medium"
                android:padding="8dp"/>

            <!-- Sign In Button -->
            <Button
                android:id="@+id/loginButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Sign In"
                android:textSize="16sp"
                android:textColor="@color/white"
                android:background="@drawable/button_retro_orange"
                android:fontFamily="sans-serif-medium"
                android:elevation="2dp"
                android:stateListAnimator="@null"/>

        </LinearLayout>

        <!-- Divider -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginVertical="24dp">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/divider_vintage"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:text="or continue with"
                android:textSize="14sp"
                android:textColor="@color/text_tertiary_vintage"
                android:fontFamily="sans-serif"/>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/divider_vintage"/>

        </LinearLayout>

        <!-- Social Login Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="32dp">

            <!-- Google Button -->
            <Button
                android:id="@+id/btn_google"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="Google"
                android:textSize="14sp"
                android:textColor="@color/text_primary_vintage"
                android:background="@drawable/button_outlined_retro_orange"
                android:drawableStart="@drawable/ic_google"
                android:drawablePadding="8dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"/>

            <!-- Apple Button -->
            <Button
                android:id="@+id/btn_apple"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Apple"
                android:textSize="14sp"
                android:textColor="@color/text_primary_vintage"
                android:background="@drawable/button_outlined_retro_orange"
                android:drawableStart="@drawable/ic_apple"
                android:drawablePadding="8dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"/>

        </LinearLayout>

        <!-- Sign Up Link -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/guestTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Don't have an account? "
                android:textSize="14sp"
                android:textColor="@color/text_secondary_vintage"
                android:fontFamily="sans-serif"/>

            <TextView
                android:id="@+id/registerTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sign Up"
                android:textSize="14sp"
                android:textColor="@color/retro_orange"
                android:fontFamily="sans-serif-medium"
                android:padding="4dp"/>

        </LinearLayout>

    </LinearLayout>

</ScrollView>