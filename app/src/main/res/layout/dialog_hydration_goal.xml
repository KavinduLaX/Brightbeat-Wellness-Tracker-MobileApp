<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/rounded_dialog_background"
    android:padding="28dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💧"
            android:textSize="40sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:text="Hydration Goal"
            android:textColor="@color/text_primary"
            android:textSize="24sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium" />

    </LinearLayout>

    <!-- Goal Input -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:hint="Daily goal in ml"
        app:boxBackgroundColor="@color/surface_card"
        app:boxBackgroundMode="filled"
        app:boxCornerRadiusTopStart="16dp"
        app:boxCornerRadiusTopEnd="16dp"
        app:boxCornerRadiusBottomStart="16dp"
        app:boxCornerRadiusBottomEnd="16dp"
        app:boxStrokeWidth="0dp"
        app:boxStrokeWidthFocused="2dp"
        app:hintTextColor="@color/primary_coral"
        app:prefixText="💧 "
        app:prefixTextColor="@color/primary_coral">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/goalEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:text="2000"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:padding="20dp" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Quick Goals -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="Quick goals"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:textStyle="bold" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/quickGoalsChipGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="28dp"
        app:singleLine="false"
        app:chipSpacingHorizontal="10dp"
        app:chipSpacingVertical="8dp">

        <com.google.android.material.chip.Chip
            android:id="@+id/chip1500ml"
            style="@style/Widget.Material3.Chip.Assist"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="1500 ml"
            android:textSize="15sp"
            app:chipBackgroundColor="@color/surface_card"
            app:chipCornerRadius="24dp"
            app:chipStrokeWidth="0dp" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip2000ml"
            style="@style/Widget.Material3.Chip.Assist"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:checked="true"
            android:text="2000 ml"
            android:textSize="15sp"
            app:chipBackgroundColor="@color/primary_coral"
            app:chipCornerRadius="24dp"
            app:chipStrokeWidth="0dp" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip2500ml"
            style="@style/Widget.Material3.Chip.Assist"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="2500 ml"
            android:textSize="15sp"
            app:chipBackgroundColor="@color/surface_card"
            app:chipCornerRadius="24dp"
            app:chipStrokeWidth="0dp" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip3000ml"
            style="@style/Widget.Material3.Chip.Assist"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="3000 ml"
            android:textSize="15sp"
            app:chipBackgroundColor="@color/surface_card"
            app:chipCornerRadius="24dp"
            app:chipStrokeWidth="0dp" />

    </com.google.android.material.chip.ChipGroup>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/cancelButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:layout_marginEnd="12dp"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:text="Cancel"
            android:textColor="@color/text_secondary"
            android:textSize="15sp"
            android:textStyle="bold"
            app:cornerRadius="28dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/saveButton"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:paddingStart="36dp"
            android:paddingEnd="36dp"
            android:text="Save Goal"
            android:textColor="@color/surface_white"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="@color/primary_coral"
            app:cornerRadius="28dp"
            app:elevation="4dp" />

    </LinearLayout>

</LinearLayout>
